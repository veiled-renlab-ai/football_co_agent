# Copy this file to `.env` and fill in your actual keys.
# `.env` is gitignored — never commit real keys.

# === LLM provider selection ===
# Choose one:  volcengine  |  minimax
LLM_PROVIDER=volcengine

# === 火山方舟 (Volcengine ARK) ===
# Get key from: https://console.volcengine.com/ark
VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
# Pick a model with strong function-calling, e.g.:
#   doubao-seed-1.6-250615
#   deepseek-v3.2
VOLCENGINE_MODEL=doubao-seed-1.6-250615

# === MiniMax ===
# Get key from: https://www.minimax.io/platform
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M1
